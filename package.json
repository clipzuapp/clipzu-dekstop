{
  "name": "clipzu-desktop-beta",
  "version": "1.0.0",
  "description": "Clipzu Desktop Beta - Desktop video editor with offline transcription, caption styling, and multi-format export",
  "main": "./out/main/index.js",
  "author": "Clipzu",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/prepare-native-runtime.mjs",
    "pack": "node scripts/prepare-runtime-resources.mjs && node scripts/prepare-package-assets.mjs && electron-vite build && electron-builder --dir",
    "verify:package": "node scripts/verify-package.mjs dist/win-unpacked",
    "dist": "node scripts/prepare-runtime-resources.mjs && node scripts/prepare-package-assets.mjs && electron-vite build && electron-builder",
    "dist:win": "node scripts/prepare-runtime-resources.mjs && node scripts/prepare-package-assets.mjs && electron-vite build && electron-builder --win",
    "dist:mac": "node scripts/prepare-runtime-resources.mjs && node scripts/prepare-package-assets.mjs && electron-vite build && electron-builder --mac",
    "dist:linux": "node scripts/prepare-runtime-resources.mjs && node scripts/prepare-package-assets.mjs && electron-vite build && electron-builder --linux",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:project-format": "tsc -p tsconfig.test.json && node --test out-test/shared/project/integration/roundtrip.inttest.js out-test/shared/project/integration/lifecycle.inttest.js out-test/shared/project/integration/channels.inttest.js out-test/main/project/saveCoordinator.inttest.js out-test/shared/project/integration/exportGraph.inttest.js out-test/shared/project/integration/legacy.inttest.js out-test/shared/project/integration/undo.inttest.js out-test/shared/project/integration/tracks.inttest.js out-test/shared/project/integration/captionLanes.inttest.js out-test/shared/project/integration/uiPrefs.inttest.js out-test/shared/project/integration/images.inttest.js out-test/shared/project/integration/paths.inttest.js out-test/shared/project/integration/fuzz.inttest.js out-test/shared/project/integration/model.inttest.js out-test/shared/project/integration/diagnostics.inttest.js out-test/shared/project/integration/geometry.inttest.js out-test/shared/project/integration/relink.inttest.js out-test/shared/project/integration/golden.inttest.js out-test/shared/utils/utils.inttest.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^12.1.0",
    "electron-updater": "^6.8.9",
    "immer": "^10.1.1",
    "lucide-react": "^1.18.0",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "yauzl": "^2.10.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
